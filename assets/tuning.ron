// All feel parameters. Hot-reloaded by the game: save this file and changes apply live.
// Units: meters, seconds, m/s, m/s². Angles in degrees.
(
    tick_rate: 60,
    preview_horizon: 5.0,   // seconds of own-car preview while paused
    vehicle: (
        length: 4.5,
        width: 1.9,
        wheelbase: 2.7,
        max_steer_deg: 35.0,
        steer_rate_deg: 120.0,

        engine_accel: 8.0,
        top_speed: 42.0,
        reverse_accel: 3.0,
        reverse_top_speed: 8.0,
        brake_decel: 10.0,
        rolling_resistance: 0.3,
        drag: 0.0004,

        // Friction circle radius = grip * gravity.
        gravity: 9.81,
        grip: 1.5,
        slide_grip: 0.75,

        // Grip demand zones: green < comfort_demand < yellow < 1.0 < orange (understeer:
        // runs wide). Slides come from the stability gauge (below) or the handbrake.
        comfort_demand: 0.7,
        understeer_scrub: 0.3,   // g of drag per unit of demand over 1.0 (plowing)

        // Slide behavior.
        slide_steer_authority: 0.35,
        slide_yaw_tau: 0.5,
        slide_exit_lat_speed: 1.0,
        slide_exit_demand: 0.85,
        slide_exit_yaw_error_deg: 15.0,

        handbrake_decel: 3.0,
        handbrake_grip: 0.6,
        handbrake_yaw_gain: 1.8,
        handbrake_min_speed: 3.0,
    ),
    // Stability gauge: 1 = calm, 0 = certain loss of control.
    stability: (
        k_drain: 3.0,        // drain/s = k_drain * (demand - comfort)^2 above comfort
        k_jerk: 0.05,        // drain per unit of grip-demand change (harsh transitions)
        k_rec: 0.3,          // recovery/s = k_rec * pilot skill, below comfort
        yellow: 0.6,         // below: risk checks roll for loss of control
        risk_interval: 0.25, // s between checks (yellow zone, above comfort)
        risk_max: 0.35,      // chance per check near 0: risk_max * (1 - s/yellow)^2
        min_speed: 10.0,     // m/s (36 km/h); slower cars never lose control, they just understeer
        skid_speed: 12.0,    // m/s; below: always a skid
        spin_speed: 25.0,    // m/s; above: always a spin
        skid_yaw_kick: 1.0,  // rad/s into the turn
        spin_yaw_kick: 5.0,
        after_loss: 0.3,     // stability right after losing control
    ),
    // Planning tool.
    planner: (
        default_throttle: 0.4,      // new keypoint throttle when the car would sit still
        throttle_step: 0.05,        // per mouse-wheel notch
        max_lateral_g: 3.0,         // tightest planned turn (g), both turn modes
        straight_seconds: 1.0,      // length of a keypoint added with "Straight"
        drift_recover_seconds: 0.5, // drift fans: how long the outward offset lingers after the plan is back in grip
    ),
    // Debug keyboard driving (M key toggles manual mode).
    // Full key input asks for a lateral grip demand, not a wheel angle.
    keyboard: (
        steer_ramp_per_s: 2.0,
        steer_return_per_s: 5.0,
        full_steer_demand: 0.9,  // A/D: hard cornering, stays in yellow
        push_steer_demand: 3.0,  // Ctrl+A/D: beyond the limit
    ),
)
