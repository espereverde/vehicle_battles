// All feel parameters. Hot-reloaded by the game: save this file and changes apply live.
// Units: meters, seconds, m/s, m/s². Angles in degrees.
(
    tick_rate: 60,
    preview_horizon: 5.0,   // seconds of own-car preview while paused
    vehicle: (
        length: 4.5,
        width: 1.9,
        wheelbase: 2.7,
        max_steer_deg: 35.0,

        engine_accel: 8.0,
        top_speed: 42.0,
        reverse_accel: 3.0,
        reverse_top_speed: 8.0,
        brake_decel: 10.0,
        rolling_resistance: 0.3,
        drag: 0.0004,

        gravity: 9.81,
        handling_class: 3.0,     // Car Wars HC: max handling status; recovery/s = HC + skill (>= 1)

        handbrake_decel: 3.0,    // extra braking
    ),
    // Handling status and control checks (Car Wars, continuous). Control Table speeds in mph.
    handling: (
        min_status: -6.0,
        safe_speed_mph: 106.0,     // one roll fails with clamp((v - safe - per_status*HS) / range)
        mph_per_status: 27.0,
        fail_range_mph: 130.0,
        bend_deg: 15.0,            // heading change per handling point (D1 bend)
        drift_cost: 1.0,           // points per inch forward drifting 1/4" sideways per inch (D1)
        steep_drift_cost: 3.0,     // ... at 1/2" per inch, the steepest (D3)
        free_braking_mph_s: 10.0,  // harder braking drains: 15 mph/s -> 1/s, 20 -> 2, 25 -> 3, +2 per 5
    ),
    // Crash results and controlled skids (Car Wars values).
    crash: (
        spin_deg_per_s: 450.0,     // spinout: 90 degrees per phase (0.2 s)
        decel_mph_s: 20.0,         // spinout and roll deceleration
        tstop_mph_per_inch: 20.0,  // T-stop deceleration per inch slid
        recovery_seconds: 1.0,     // between spinout recovery rolls (at handling -6)
        stop_speed: 0.3,           // m/s; below: a spinout, T-stop or roll has stopped
        skid_cost_per_inch: 4.0,   // controlled skid: +1 per 1/4" slid
        skid_seconds_per_inch: 1.0, // ... lasts this long per book inch (1/4" -> 0.25 s), so it shows at any speed
        skid_turn_seconds: 0.25,   // ... its nose swings round over the slide's first seconds
        max_skid_deg: 90.0,        // ... by at most this much
        // Easing: the book says where the car ends up, these say how smoothly it gets there.
        slide_entry_seconds: 0.15, // a slide's direction of travel swings over from the car's
        regrip_seconds: 0.35,      // ... and back onto the nose after it
        spin_up_seconds: 0.4,      // spinout rotation builds up from the car's turn (a T-stop's dies down)
        spin_fade_speed: 6.0,      // ... and winds down below this speed (m/s)
        roll_turn_seconds: 0.3,    // a roll turns the car sideways over this long
        fishtail_seconds: 0.25,    // a fishtail swings the rear round over this long
    ),
    // Planning tool.
    planner: (
        default_throttle: 0.4,      // new keypoint throttle when the car would sit still
        throttle_step: 0.05,        // per mouse-wheel notch
        straight_seconds: 1.0,      // length of a keypoint added with "Straight"
    ),
    // Debug keyboard driving (M key toggles manual mode).
    // Full key input asks for a lateral acceleration, not a wheel angle.
    keyboard: (
        steer_ramp_per_s: 2.0,
        steer_return_per_s: 5.0,
        full_steer_g: 1.35,  // A/D
        push_steer_g: 4.5,   // Ctrl+A/D
    ),
)
